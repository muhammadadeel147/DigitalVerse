<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect non-www to www
  RewriteCond %{HTTP_HOST} !^www\.
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Remove trailing slashes (except for directories)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://www.%{HTTP_HOST}/$1 [L,R=301]

  # Allow direct execution of the PHP form endpoint.
  RewriteRule ^api/form-handler\.php$ - [L]

  # Serve existing files and folders directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all SPA routes to index.html.
  RewriteRule ^ index.html [L]
</IfModule>

# Aggressive caching for static assets (1 month)
<FilesMatch "\.(js|css|woff|woff2|ttf|otf|eot|svg|jpg|jpeg|png|gif|ico|webp)$">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    Header append Cache-Control "public, immutable"
  </IfModule>
  Header append Vary "Accept-Encoding"
</FilesMatch>

# Cache HTML for shorter period (1 hour) to allow updates
<FilesMatch "\.html$">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
  </IfModule>
  Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>

# Gzip compression for faster transfer
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Set correct MIME types
<IfModule mod_mime.c>
  AddType application/javascript js
  AddType application/wasm wasm
  AddType font/woff2 woff2
  AddEncoding gzip svgz
</IfModule>

# Remove ETags to reduce server processing
Header unset ETag
FileETag None

# Security headers that also improve performance
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
